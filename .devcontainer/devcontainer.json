{
  "name": "C# Design Patterns · .NET 11",
  "image": "mcr.microsoft.com/devcontainers/dotnet:2.3.5-11.0-resolute",
  "features": {
    "ghcr.io/devcontainers/features/node:2": {
      "version": "24"
    }
  },
  "postCreateCommand": "pwsh -NoLogo -NoProfile -File .devcontainer/post-create.ps1",
  "forwardPorts": [4173],
  "portsAttributes": {
    "4173": {
      "label": "学习站点预览",
      "onAutoForward": "openPreview"
    }
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-dotnettools.csdevkit",
        "ms-dotnettools.csharp",
        "ms-vscode.powershell"
      ],
      "settings": {
        "dotnet.defaultSolution": "DesignPatterns.sln",
        "files.exclude": {
          "**/bin": true,
          "**/obj": true
        }
      }
    }
  },
  "remoteUser": "vscode"
}
