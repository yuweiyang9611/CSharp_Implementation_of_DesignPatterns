#!/bin/sh

set -eu

email=$(git config --get user.email || true)

case "$email" in
    *@users.noreply.github.com|noreply@github.com)
        exit 0
        ;;
    *)
        printf '%s\n' 'Commit blocked: Git user.email must be a GitHub noreply address.' >&2
        printf '%s\n' 'Set it with: git config user.email "YOUR_NOREPLY_ADDRESS"' >&2
        exit 1
        ;;
esac
