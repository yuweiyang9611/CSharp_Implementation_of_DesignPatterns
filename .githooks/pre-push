#!/bin/sh

set -eu

remote_name=$1
zero=0000000000000000000000000000000000000000
repository_root=$(git rev-parse --show-toplevel)
verifier="$repository_root/scripts/verify-commit-email-privacy.sh"
status=0

while read -r local_ref local_sha remote_ref remote_sha; do
    if [ "$local_sha" = "$zero" ]; then
        continue
    fi

    if [ "$remote_sha" = "$zero" ]; then
        if ! "$verifier" "$local_sha" --not --remotes="$remote_name"; then
            status=1
        fi
    elif ! "$verifier" "$remote_sha..$local_sha"; then
        status=1
    fi
done

exit "$status"
